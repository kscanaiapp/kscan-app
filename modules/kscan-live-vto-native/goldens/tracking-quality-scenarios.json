        { "kind": "observe", "monotonicMs": 99, "outcome": "POSE_RESOLVED", "trackingConfidence": 0.4, "geometryGatePassed": true, "geometryFailure": null, "personFrameAvailable": true,
          "expect": { "event": null, "phase": "ACQUIRED", "confidence": 0.4, "guidance": "none", "captureReady": true } },
        { "kind": "observe", "monotonicMs": 132, "outcome": "POSE_RESOLVED", "trackingConfidence": 0.4, "geometryGatePassed": true, "geometryFailure": null, "personFrameAvailable": true,
          "expect": { "event": { "name": "trackingWeak", "payload": { "confidence": 0.4, "guidance": "hold_still", "captureReady": false } }, "phase": "WEAK", "confidence": 0.4, "guidance": "hold_still", "captureReady": false } },
