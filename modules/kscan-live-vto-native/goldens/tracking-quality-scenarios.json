        { "kind": "observe", "monotonicMs": 1166, "outcome": "POSE_RESOLVED", "trackingConfidence": 0.9, "geometryGatePassed": true, "geometryFailure": null, "personFrameAvailable": true,
          "expect": { "event": { "name": "trackingRecovered", "payload": { "confidence": 0.9, "captureReady": true } }, "phase": "ACQUIRED", "confidence": 0.9, "guidance": "none", "captureReady": true } }
      ]
    },
    {
      "name": "a refused pose is guidance to step back, and sustained refusal is a loss",
      "why": "POSE_REFUSED means the provider looked and saw nobody -- a different fact from a frame never arriving, and the one case where staleness accumulates while observations keep coming.",
