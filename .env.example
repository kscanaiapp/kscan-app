# K Scan Google Glasses — environment placeholders (copy to .env, never commit .env)

# Debug-only backend analyze config (Phase 3B).
# These are blank by default. Real values must be supplied locally and never committed.
KSCAN_DEBUG_ANALYZE_URL=
KSCAN_DEBUG_ANALYZE_AUTH_TOKEN=
KSCAN_DEBUG_ANALYZE_DRY_RUN=false

# Supabase (phone bridge relay — placeholders only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder

# Bridge mode: mock | phone | google
KSCAN_BRIDGE_MODE=mock

# Android app runtime (BuildConfig / local dev)
KSCAN_USE_MOCK_BRIDGE=true
KSCAN_USE_MOCK_API=true
KSCAN_USE_MOCK_SANITIZER=true
