# ─────────────────────────────────────────────────────────────────────────────
# K Scan AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider Keys (server-side only — never expose to the app bundle) ──────

# Google Gemini API key (used when USE_OPENROUTER=false)
GEMINI_API_KEY=

# OpenRouter API key (used when USE_OPENROUTER=true)
OPENROUTER_API_KEY=

# OpenRouter model string — default is meta-llama/llama-4-scout
OPENROUTER_MODEL=meta-llama/llama-4-scout

# Set to "true" to route analysis through OpenRouter instead of Gemini directly
USE_OPENROUTER=true

# ── Server Config ─────────────────────────────────────────────────────────────

# Port the server listens on.
# - Local dev: 3001 (default, no need to set)
# - Hosted (Render/Railway): injected automatically by the platform — do NOT set here
PORT=3001

# CORS origin restriction.
# - Local dev: * (open)
# - Production: set to your app's actual origin if you have a web frontend.
#   For a pure native app with no web frontend, * is acceptable.
CORS_ORIGIN=*

# Verbose product-matching log. Set to "false" in production to reduce log noise.
KSCAN_LOG_MATCH=true

# ── Expo App Config (EXPO_PUBLIC_ prefix exposes variable to the app bundle) ──
#
# Pick the line that matches your current dev environment and uncomment it.
# Only ONE should be active at a time.

# iOS Simulator (shares host network — localhost resolves correctly):
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Android Emulator (10.0.2.2 is the emulator's loopback alias for the host):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# Physical Android/iOS device on the same Wi-Fi (replace with your machine's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.X:3001

# Hosted beta backend on Render (replace with your actual service URL):
# EXPO_PUBLIC_API_URL=https://kscan-api.onrender.com

# ── Supabase (account-level privacy sync — requires real Supabase Auth) ───────
#
# These two variables are required for the Supabase project to be reachable.
# The app uses @supabase/supabase-js with AsyncStorage session persistence.
# Account-level privacy preferences are persisted using the authenticated
# session token — NOT a manually pasted access token.
#
# App Staging project (scan-identify + catalog retrieval testing):
# EXPO_PUBLIC_SUPABASE_URL=https://wyyuqfdxucjksghsmhry.supabase.co
#
# Production / Privacy project values must NOT be pasted here.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
#
# ── DEV-ONLY: Manual access token override (internal testing only) ───────────
#
# EXPO_PUBLIC_SUPABASE_ACCESS_TOKEN is a development bridge for testing
# privacy persistence without completing a real sign-in flow.
# It is NEVER the normal production path. If a real Supabase Auth session
# exists, it always takes precedence over this value.
#
# Remove or leave blank for normal operation.
# If set, a console warning is shown: "DEV TOKEN IN USE".
#
# EXPO_PUBLIC_SUPABASE_ACCESS_TOKEN=eyJ...

# ── Scan Identification backend (KS-REL-008C) ─────────────────────────────────
#
# Routes image Scan analysis through the Supabase Edge Function scan-identify.
# Set to "true" for App Staging / dev testing. Defaults to false.
# EXPO_PUBLIC_SCAN_IDENTIFY_BACKEND_ENABLED=true
# Routes TextScan analysis through scan-identify text mode instead of the
# non-live placeholder result. Keep aligned with the image Scan flag.
# EXPO_PUBLIC_TEXTSCAN_BACKEND_ENABLED=true

# scan-identify Edge Function operator tunables (set in Supabase Dashboard → Secrets).
# SCAN_IDENTIFY_AI_ENABLED=true
# SCAN_GEMINI_MODEL=gemini-2.0-flash-exp
# GEMINI_MODEL=gemini-2.0-flash-exp
# SCAN_GEMINI_TIMEOUT_MS=14000
# SCAN_IDENTIFY_IMAGE_DAILY_LIMIT=30
# SCAN_IDENTIFY_TEXT_DAILY_LIMIT=50

# Secondhand First / Vinted resale search (Supabase Edge Function only)
# These are server-side Supabase secrets. Do not prefix them with EXPO_PUBLIC_.
# SECONDHAND_VINTED_ENABLED=true
# APIFY_API_TOKEN=
# APIFY_VINTED_ACTOR_ID=
# APIFY_VINTED_TIMEOUT_SECS=20
# APIFY_VINTED_INPUT_TEMPLATE=

# ── RapidAPI (shared key — Supabase Edge Function secret only) ───────────────
#
# A single key used by all RapidAPI-backed Edge Functions (KicksCrew, Try-On…).
# Set this in Supabase Dashboard → Project Settings → Secrets, NOT here.
# NEVER use EXPO_PUBLIC_RAPIDAPI_KEY — this key must stay server-side.
# RAPIDAPI_KEY=

# ── Sneaker Enrichment ────────────────────────────────────────────────────────
#
# Set to "false" to globally disable the sneaker enrichment layer.
# Defaults to enabled.  Safe to leave unset.
# EXPO_PUBLIC_ENABLE_SNEAKER_ENRICHMENT=true

# The Sneaker Database (api.thesneakerdatabase.com) — free tier 500 req/month.
# Requires an API key.  Do NOT use the EXPO_PUBLIC_ prefix here — this key must
# never appear in the client bundle.  Set it only in your backend or Supabase
# Edge Function environment.
# SNEAKER_DATABASE_API_KEY=

# KicksDB API key (reserved for future key-gated provider).
# Same rule as above — server-side only, no EXPO_PUBLIC_ prefix.
# KICKSDB_API_KEY=

# Sneaks-API — self-hosted Express server (github.com/druv5319/Sneaks-API).
# The base URL is not a secret, so use the EXPO_PUBLIC_ prefix to make it
# readable by the Expo client.  Leave blank to disable this provider.
# EXPO_PUBLIC_SNEAKS_API_BASE_URL=http://localhost:3002
# SNEAKS_API_BASE_URL=   (server-side alias; checked as fallback)

# HoseaCodes Sneaker-API (or any compatible no-token free sneaker REST API).
# Point at a deployed instance of github.com/hoseacodes/sneaker-api or any
# API that responds to GET /api/v1/products?name={query}&limit=5.
# Leave blank to disable this provider.
# EXPO_PUBLIC_HOSEA_API_BASE_URL=
