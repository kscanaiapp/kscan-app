# K Scan Google Glasses — environment placeholders (copy to .env, never commit .env)

# Glasses analyze debug endpoint (Node backend — backend/server.js).
# Leave blank/disabled by default. Enable only for controlled smoke tests.
KSCAN_GLASSES_PORT=3002
KSCAN_GLASSES_ANALYZE_DEBUG_TOKEN=
KSCAN_GLASSES_ANALYZE_ENABLED=false
KSCAN_GLASSES_ANALYZE_MODEL=mock
KSCAN_GLASSES_ANALYZE_BACKEND_URL=

# Android debug URL/flags belong in gitignored android-xr/local.properties:
#   KSCAN_DEBUG_ANALYZE_ENABLED=true
#   KSCAN_DEBUG_ANALYZE_URL=http://10.0.2.2:3002/api/glasses/analyze-debug
#   KSCAN_DEBUG_ANALYZE_DRY_RUN=false
# Auth tokens must NOT go in BuildConfig. Push at runtime:
#   adb shell "echo -n 'TOKEN' > /data/local/tmp/kscan_glasses_debug_token"

# Supabase (phone bridge relay — placeholders only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder

# Bridge mode: mock | phone | google
KSCAN_BRIDGE_MODE=mock

# Android app runtime (BuildConfig / local dev)
KSCAN_USE_MOCK_BRIDGE=true
KSCAN_USE_MOCK_API=true
KSCAN_USE_MOCK_SANITIZER=true
