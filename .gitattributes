# Normalize line endings to LF in the repo, checkout as native on each OS
* text=auto

# Source code — always LF in repo
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Config files
*.properties text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
# Edge Function config.toml files are hashed byte-for-byte by the Edge
# Function manifest/parity gates (scripts/generate-edge-function-manifest.js).
# Without an explicit eol pin, core.autocrlf=true checks them out CRLF on
# Windows and the gates then report a false "deployable source does not match
# the manifest" failure against an unmodified tree.
*.toml text eol=lf

# Truly binary — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.aab binary
*.apk binary
*.keystore binary
*.jks binary
*.p8 binary
*.hbc binary
