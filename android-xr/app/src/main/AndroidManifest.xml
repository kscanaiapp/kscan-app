<?xml version="1.0" encoding="utf-8"?>
<!--
  Main manifest permission surface: intentionally EMPTY.

  This build captures no audio, drives no camera, and vibrates no motor — the
  glasses camera controllers are explicit TODO stubs and all input arrives via
  key events or the companion bridge. See docs/google/PERMISSION_MATRIX.md.

  android.permission.INTERNET is NOT here: it exists only in the debug overlay
  (src/debug/AndroidManifest.xml) for local debug-backend smoke testing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".KScanApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KScanGlasses">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.KScanGlasses">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
