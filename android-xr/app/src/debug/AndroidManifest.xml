<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  This manifest is merged ONLY into debug builds.
  Release and main builds do NOT receive this permission or cleartext policy.

  android.permission.INTERNET is added here strictly for:
  - local emulator smoke testing against the debug backend endpoint
  - local device testing on a trusted LAN

  It must NEVER be added to src/main/AndroidManifest.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:networkSecurityConfig="@xml/network_security_config">
        <!--
          Debug-only emulator-validation seam. Exported so the adb shell can
          deliver scenario broadcasts on production (user-build) emulator
          images where `adb root` is unavailable; double-gated at runtime
          (mock-bridge flag + mock provider instance) so it no-ops unless the
          in-memory mock bridge is active. Never merged into release builds.
        -->
        <receiver
            android:name=".MockScenarioReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kscan.glasses.action.MOCK_SCENARIO" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
