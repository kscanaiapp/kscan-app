{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kscan.app/contracts/product-match-v1.schema.json",
  "title": "K Scan Product Match V1",
  "description": "Canonical product family / variant / listing contract returned by the internal product-match endpoint. Text attributes in, evidence-tiered matches out, plus advisory comparisons against items the user already has. The query carries no image data and no user identifier by design; see supabase/functions/product-match/index.ts.",
  "type": "object",
  "definitions": {
    "productSource": {
      "type": "string",
      "enum": ["kickscrew", "farfetch", "serper", "brave", "catalog"],
      "description": "Sources already reachable from the deployed scan-identify closure. No new external providers are introduced by this contract."
    },
    "matchTier": {
      "type": "string",
      "enum": ["EXACT", "LIKELY_EXACT", "PRODUCT_FAMILY", "SIMILAR", "NO_CONFIDENT_MATCH"],
      "description": "EXACT requires decisive, authoritative identity evidence — an authoritative identifier (verified GTIN, manufacturer style code, first-party manufacturer record) which is sufficient alone, or the same identifier corroborated by two independent id-bearing catalogues. Not reachable by accumulating soft signals, and not reachable from a single retailer's own catalogue id. Separately, exact CLAIMS are disabled by default and reported as LIKELY_EXACT until the evidence paths are validated."
    },
    "evidenceKind": {
      "type": "string",
      "enum": [
        "authoritative_product_id",
        "corroborated_product_id",
        "exact_product_id",
        "visible_brand_text",
        "brand_guess",
        "model_token",
        "colorway",
        "category",
        "material",
        "silhouette",
        "pattern",
        "cross_source_agreement"
      ]
    },
    "queryStrategy": {
      "type": "string",
      "enum": [
        "caller_supplied",
        "visible_brand_model",
        "brand_model",
        "brand_color_category",
        "material_silhouette_category",
        "category_color"
      ],
      "description": "Named query construction paths. Naming them makes retrieval attributable: a caller_supplied result and a category_color result are different claims about how much was known."
    },
    "stageName": {
      "type": "string",
      "enum": ["plan", "retrieve", "normalize", "relevance", "dedupe", "tier", "similarity"]
    },
    "stageTiming": {
      "type": "object",
      "required": ["stage", "durationMs", "itemCount"],
      "additionalProperties": false,
      "properties": {
        "stage": { "$ref": "#/definitions/stageName" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "itemCount": { "type": "integer", "minimum": 0 }
      }
    },
    "matchEvidence": {
      "type": "object",
      "required": ["kind", "weight"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/definitions/evidenceKind" },
        "detail": { "type": "string", "maxLength": 200 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "productFamily": {
      "type": "object",
      "required": ["familyKey", "brand", "model", "canonicalCategory", "displayName"],
      "additionalProperties": false,
      "properties": {
        "familyKey": { "type": "string", "minLength": 1 },
        "brand": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "canonicalCategory": { "type": ["string", "null"] },
        "displayName": { "type": "string" }
      }
    },
    "productVariant": {
      "type": "object",
      "required": ["variantKey", "familyKey", "colorway", "exactProductId", "sizeHint"],
      "additionalProperties": false,
      "properties": {
        "variantKey": { "type": "string", "minLength": 1 },
        "familyKey": { "type": "string", "minLength": 1 },
        "colorway": { "type": ["string", "null"] },
        "exactProductId": {
          "type": ["string", "null"],
          "description": "Never synthesized. Present only when a capable source supplied one."
        },
        "sizeHint": { "type": ["string", "null"] }
      }
    },
    "productListing": {
      "type": "object",
      "required": [
        "listingKey", "variantKey", "familyKey", "source", "retailer",
        "title", "productUrl", "imageUrl", "price", "currency", "availability"
      ],
      "additionalProperties": false,
      "properties": {
        "listingKey": { "type": "string", "minLength": 1 },
        "variantKey": { "type": "string", "minLength": 1 },
        "familyKey": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/definitions/productSource" },
        "retailer": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "productUrl": { "type": ["string", "null"] },
        "imageUrl": { "type": ["string", "null"] },
        "price": { "type": ["string", "null"] },
        "currency": { "type": ["string", "null"] },
        "availability": { "type": ["string", "null"] }
      }
    },
    "listingGroup": {
      "type": "object",
      "description": "One retailer's listings for a variant, rolled up. Grouping is presentation over the deduped set: dedupe decides what is the same thing, grouping decides how the survivors are arranged. Nothing is discarded.",
      "required": ["groupKey", "retailer", "source", "listings", "representativePrice"],
      "additionalProperties": false,
      "properties": {
        "groupKey": { "type": "string", "minLength": 1 },
        "retailer": { "type": ["string", "null"] },
        "source": { "$ref": "#/definitions/productSource" },
        "listings": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/productListing" } },
        "representativePrice": {
          "type": ["string", "null"],
          "description": "Verbatim from the strongest listing. Not parsed, not compared numerically, not converted — V1 has no currency model."
        }
      }
    },
    "matchedVariant": {
      "type": "object",
      "required": ["variant", "tier", "confidence", "evidence", "listings", "groups", "retailerCount"],
      "additionalProperties": false,
      "properties": {
        "variant": { "$ref": "#/definitions/productVariant" },
        "tier": { "$ref": "#/definitions/matchTier" },
        "confidence": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "Ordering score only. A tier is never reached by confidence alone."
        },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/matchEvidence" } },
        "listings": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/definitions/productListing" },
          "description": "Never empty and never collapsed: a second retailer for the same variant is information, not a duplicate."
        },
        "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/listingGroup" } },
        "retailerCount": { "type": "integer", "minimum": 1 }
      }
    },
    "matchedFamily": {
      "type": "object",
      "required": ["family", "tier", "variants"],
      "additionalProperties": false,
      "properties": {
        "family": { "$ref": "#/definitions/productFamily" },
        "tier": { "$ref": "#/definitions/matchTier" },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/matchedVariant" } }
      }
    },
    "providerOutcome": {
      "type": "object",
      "required": ["source", "status", "durationMs", "rawCount"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/definitions/productSource" },
        "status": {
          "type": "string",
          "enum": ["completed", "empty", "timeout", "error", "skipped", "disabled"]
        },
        "durationMs": { "type": "integer", "minimum": 0 },
        "rawCount": { "type": "integer", "minimum": 0 },
        "reason": {
          "type": "string", "maxLength": 64,
          "description": "Stable classifier only. Never a provider message, URL, or credential."
        }
      }
    },
    "existingItemSource": { "type": "string", "enum": ["closet", "recent_scan"] },
    "similarityReason": {
      "type": "string",
      "enum": [
        "shared_product_url",
        "authoritative_identifier_match",
        "same_brand",
        "same_model_tokens",
        "same_normalized_color",
        "same_canonical_category",
        "same_material",
        "same_silhouette",
        "same_pattern"
      ],
      "description": "Named agreements rather than a bare score, because the user is being asked to make a judgement and '87% similar' does not help them make it."
    },
    "conflictReason": {
      "type": "string",
      "enum": [
        "identifier_conflict",
        "category_conflict",
        "different_model_family",
        "different_silhouette",
        "different_colorway",
        "different_pattern"
      ],
      "description": "Checkpoint 4. Named disagreements. identifier_conflict and category_conflict are structural — either one present means no notice is produced at all; the rest lower the score without blocking a notice outright."
    },
    "similarItemAction": {
      "type": "string",
      "enum": [
        "reject_new_scan",
        "add_to_closet",
        "keep_in_recent_scans",
        "delete_existing_item",
        "shop_identified_product",
        "keep_both"
      ]
    },
    "existingItemCandidate": {
      "type": "object",
      "description": "An item the user already has, supplied by the caller. This service never reads the closet or the recent-scan list, and never fetches imageUri — it is echoed back for side-by-side display only.",
      "required": ["id", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "$ref": "#/definitions/existingItemSource" },
        "label": { "type": ["string", "null"], "maxLength": 160 },
        "imageUri": { "type": ["string", "null"], "maxLength": 2048 },
        "brand": { "type": ["string", "null"], "maxLength": 80 },
        "model": { "type": ["string", "null"], "maxLength": 120 },
        "canonicalCategory": { "type": ["string", "null"], "maxLength": 60 },
        "clothingType": { "type": ["string", "null"], "maxLength": 60 },
        "color": { "type": ["string", "null"], "maxLength": 60 },
        "material": { "type": ["string", "null"], "maxLength": 60 },
        "silhouette": { "type": ["string", "null"], "maxLength": 60 },
        "pattern": { "type": ["string", "null"], "maxLength": 60 },
        "productUrl": { "type": ["string", "null"], "maxLength": 2048 },
        "authoritativeId": { "type": ["string", "null"], "maxLength": 128 },
        "imageQuality": { "type": ["string", "null"], "enum": ["ok", "poor", "missing", null] }
      }
    },
    "similarityInternalDebug": {
      "type": "object",
      "description": "Checkpoint 4. Dev-only scoring detail, present ONLY when the caller opted in via request.debugSimilarity. Never emitted by default, so it cannot leak into production user copy by accident.",
      "required": [
        "thresholdVersion", "classification", "evidenceMode", "categoryFamily", "coverage",
        "imageAvailability", "netScore", "potentialAt", "strongAt",
        "distinctPositiveClasses", "minDistinctPositiveClasses", "adjustmentsApplied"
      ],
      "additionalProperties": false,
      "properties": {
        "thresholdVersion": { "type": "string" },
        "classification": { "type": "string", "enum": ["POTENTIAL_SIMILAR_ITEM", "STRONG_SIMILARITY"] },
        "evidenceMode": { "type": "string", "enum": ["identifier_backed", "attribute_only"] },
        "categoryFamily": { "type": "string", "enum": ["uniform_basic", "identity_strong", "general"] },
        "coverage": { "type": "string", "enum": ["rich", "partial", "thin"] },
        "imageAvailability": { "type": "string", "enum": ["both", "one_missing", "none", "poor_quality"] },
        "netScore": { "type": "number", "minimum": 0 },
        "potentialAt": { "type": "number" },
        "strongAt": { "type": "number" },
        "distinctPositiveClasses": { "type": "integer", "minimum": 0 },
        "minDistinctPositiveClasses": { "type": "integer", "minimum": 0 },
        "adjustmentsApplied": { "type": "array", "items": { "type": "string" } }
      }
    },
    "potentialSimilarItem": {
      "type": "object",
      "description": "ADVISORY ONLY, and never deduplication. There is deliberately no isDuplicate field in this contract: commerce dedupe getting it wrong costs a duplicate row, closet similarity getting it wrong costs the user an item they wanted. Nothing is merged, hidden or deleted; both records persist unless the user chooses otherwise.",
      "required": [
        "potentialSimilarItem", "existingItemId", "existingItemSource",
        "comparison", "reasons", "conflicts", "advisoryConfidence", "availableActions", "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "potentialSimilarItem": { "type": "boolean", "const": true },
        "existingItemId": { "type": "string", "minLength": 1 },
        "existingItemSource": { "$ref": "#/definitions/existingItemSource" },
        "comparison": {
          "type": "object",
          "required": ["newScanImageUri", "existingItemImageUri", "newScanLabel", "existingItemLabel"],
          "additionalProperties": false,
          "properties": {
            "newScanImageUri": { "type": ["string", "null"] },
            "existingItemImageUri": { "type": ["string", "null"] },
            "newScanLabel": { "type": ["string", "null"] },
            "existingItemLabel": { "type": ["string", "null"] }
          }
        },
        "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/similarityReason" } },
        "conflicts": {
          "type": "array", "items": { "$ref": "#/definitions/conflictReason" },
          "description": "Checkpoint 4. Soft disagreements found alongside the agreements above; may be non-empty even when a notice is shown. Never carries a STRUCTURAL conflict — those suppress the notice instead of appearing here."
        },
        "advisoryConfidence": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "Orders candidates. Never gates an action and never auto-resolves anything."
        },
        "availableActions": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": { "$ref": "#/definitions/similarItemAction" },
          "description": "Always all six. This service never decides an action is inapplicable."
        },
        "resolution": {
          "type": "string", "const": "user_required",
          "description": "The backend reports a similarity; the person decides."
        },
        "internal": { "$ref": "#/definitions/similarityInternalDebug" }
      }
    },
    "candidateRejectionReason": {
      "type": "string",
      "enum": ["no_comparable_fields", "category_conflict", "over_scoring_cap"]
    },
    "similarityRetrievalReport": {
      "type": "object",
      "required": ["sourcesChecked", "recordsConsidered", "candidatesRetained", "candidatesRejected", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "sourcesChecked": { "type": "array", "items": { "$ref": "#/definitions/existingItemSource" } },
        "recordsConsidered": { "type": "integer", "minimum": 0 },
        "candidatesRetained": { "type": "integer", "minimum": 0 },
        "candidatesRejected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "count"],
            "additionalProperties": false,
            "properties": {
              "reason": { "$ref": "#/definitions/candidateRejectionReason" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "similarityStageDiagnostics": {
      "type": "object",
      "required": ["thresholdVersion", "retrieveMs", "compareMs", "totalMs", "classifiedBeforeCap"],
      "additionalProperties": false,
      "properties": {
        "thresholdVersion": { "type": "string" },
        "retrieveMs": { "type": "integer", "minimum": 0 },
        "compareMs": { "type": "integer", "minimum": 0 },
        "totalMs": { "type": "integer", "minimum": 0 },
        "classifiedBeforeCap": { "type": "integer", "minimum": 0 }
      }
    },
    "retrievalReport": {
      "type": "object",
      "required": [
        "strategiesUsed", "fallbackUsed", "categoryConflictRejections",
        "lowRelevanceRejections", "testCatalogExclusions"
      ],
      "additionalProperties": false,
      "properties": {
        "strategiesUsed": { "type": "array", "items": { "$ref": "#/definitions/queryStrategy" } },
        "fallbackUsed": { "type": "boolean" },
        "categoryConflictRejections": { "type": "integer", "minimum": 0 },
        "lowRelevanceRejections": { "type": "integer", "minimum": 0 },
        "testCatalogExclusions": {
          "type": "integer", "minimum": 0,
          "description": "Catalog rows rejected by the production test-data gate."
        }
      }
    },
    "productMatchQuery": {
      "type": "object",
      "additionalProperties": false,
      "description": "Text attributes only. There is deliberately no field for image bytes or an image URL: this endpoint introduces no new privacy boundary.",
      "properties": {
        "brand": { "type": ["string", "null"], "maxLength": 80 },
        "visibleBrandText": { "type": ["string", "null"], "maxLength": 80 },
        "model": { "type": ["string", "null"], "maxLength": 120 },
        "canonicalCategory": { "type": ["string", "null"], "maxLength": 60 },
        "clothingType": { "type": ["string", "null"], "maxLength": 60 },
        "color": { "type": ["string", "null"], "maxLength": 60 },
        "material": { "type": ["string", "null"], "maxLength": 60 },
        "silhouette": { "type": ["string", "null"], "maxLength": 60 },
        "pattern": { "type": ["string", "null"], "maxLength": 60 },
        "styleTags": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } },
        "searchQueries": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 200 } }
      }
    }
  },
  "properties": {
    "request": {
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "$ref": "#/definitions/productMatchQuery" },
        "correlationId": { "type": "string", "maxLength": 64 },
        "sources": { "type": "array", "items": { "$ref": "#/definitions/productSource" } },
        "limit": { "type": "integer", "minimum": 1, "maximum": 24 },
        "existingItems": {
          "type": "array", "maxItems": 25,
          "items": { "$ref": "#/definitions/existingItemCandidate" }
        },
        "newScanImageUri": { "type": ["string", "null"], "maxLength": 2048 },
        "newScanLabel": { "type": ["string", "null"], "maxLength": 160 },
        "newScanProductUrl": { "type": ["string", "null"], "maxLength": 2048 },
        "newScanAuthoritativeId": { "type": ["string", "null"], "maxLength": 128 },
        "newScanImageQuality": { "type": ["string", "null"], "enum": ["ok", "poor", "missing", null] },
        "debugSimilarity": {
          "type": "boolean",
          "description": "Checkpoint 4. Dev/test opt-in only — see potentialSimilarItem.internal."
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "contractVersion", "version", "tier", "families", "listings",
        "providers", "timings", "potentialSimilarItems", "retrieval"
      ],
      "additionalProperties": false,
      "properties": {
        "contractVersion": { "type": "integer", "const": 1 },
        "version": { "type": "string" },
        "tier": { "$ref": "#/definitions/matchTier" },
        "families": { "type": "array", "items": { "$ref": "#/definitions/matchedFamily" } },
        "listings": { "type": "array", "items": { "$ref": "#/definitions/productListing" } },
        "providers": { "type": "array", "items": { "$ref": "#/definitions/providerOutcome" } },
        "potentialSimilarItems": { "type": "array", "items": { "$ref": "#/definitions/potentialSimilarItem" } },
        "retrieval": { "$ref": "#/definitions/retrievalReport" },
        "similarityRetrieval": { "$ref": "#/definitions/similarityRetrievalReport" },
        "similarityDiagnostics": { "$ref": "#/definitions/similarityStageDiagnostics" },
        "timings": {
          "type": "object",
          "required": [
            "firstUsefulMatchMs", "completeMs", "deadlineExceeded", "partial",
            "stages", "sequentialEquivalentMs", "baselineDeltaMs", "firstUsefulSlow"
          ],
          "additionalProperties": false,
          "properties": {
            "firstUsefulMatchMs": {
              "type": ["integer", "null"], "minimum": 0,
              "description": "Time to the first match at a useful tier. Measured, never used to relax a tier."
            },
            "completeMs": { "type": "integer", "minimum": 0 },
            "deadlineExceeded": { "type": "boolean" },
            "partial": {
              "type": "boolean",
              "description": "True when at least one provider was lost while at least one other returned listings. The result is usable but incomplete."
            },
            "stages": {
              "type": "array", "items": { "$ref": "#/definitions/stageTiming" },
              "description": "Per-stage attribution. The deliverable of the latency work — a total is not actionable, a breakdown is."
            },
            "sequentialEquivalentMs": {
              "type": "integer", "minimum": 0,
              "description": "What the same providers would have cost run sequentially, so the benefit of concurrency is data rather than assertion."
            },
            "baselineDeltaMs": {
              "type": "integer",
              "description": "completeMs measured against the ~9.2s production scan anchor. Negative means inside the current budget. Reported for attribution; nothing branches on it."
            },
            "firstUsefulSlow": {
              "type": "boolean",
              "description": "First useful match arrived past the observational threshold. A label for finding slow cases — nothing was truncated because of it."
            }
          }
        },
        "emptyReason": {
          "type": "string",
          "enum": ["no_query", "no_eligible_providers", "no_results", "below_confidence"]
        }
      }
    }
  },
  "required": ["request", "response"],
  "additionalProperties": false
}
