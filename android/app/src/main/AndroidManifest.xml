<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
  <!--
    Android Repair 02 (merged-manifest foreground-service exposure).

    expo-audio's own AndroidManifest.xml unconditionally contributes
    FOREGROUND_SERVICE and FOREGROUND_SERVICE_MEDIA_PLAYBACK -- the second
    exists only to let its AudioControlsService (a mediaPlayback-typed
    MediaSessionService, lock-screen/notification playback controls) run as a
    foreground service. K Scan's only expo-audio call site
    (services/avatars/stylistAudioPlayback.ts, Elise/stylist speech) never
    calls setActiveForLockScreen -- the one API that activates that service
    (node_modules/expo-audio/android/.../AudioPlayer.kt) -- and always passes
    shouldPlayInBackground: false. With that service removed below and no
    other package in this dependency tree declaring a foreground service
    (verified: `grep -rl foregroundServiceType node_modules/**/AndroidManifest.xml`
    finds only expo-audio and expo-location, both governed here), the generic
    FOREGROUND_SERVICE permission itself has no remaining purpose either.

    MODIFY_AUDIO_SETTINGS is deliberately NOT removed here: it is not a
    foreground-service permission, and setAudioModeAsync -- called on every
    stylist speech playback -- reaches AudioManager.setMode()/
    setSpeakerphoneOn() (node_modules/expo-audio/android/.../AudioModule.kt,
    updatePlaySoundThroughEarpiece(), invoked unconditionally from
    setAudioModeAsync regardless of shouldRouteThroughEarpiece's value), so it
    is genuinely required for the foreground playback K Scan uses.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
    <!--
      Android 11+ (API 30) package visibility filtering. Without a matching
      <queries> entry, Linking.canOpenURL('mailto:...') resolves nothing and
      returns false even when the device has a mail app installed.

      The Dressing Room "Report & Hide" flow
      (components/rooms/RoomMessagesPanel.tsx) reports through the
      server-backed submitContentReport() path and hides the content locally.
      Only when the server does NOT accept the report does it offer the
      support-email fallback, and then tells the user the report "can also be
      sent to K Scan AI support". Without this declaration that sentence is
      false on every Android 11+ device: canOpenURL returns false, no mail app
      opens, and the user is told otherwise.

      Declared as ACTION_SENDTO + the mailto scheme -- the narrowest form that
      matches an email client. It grants visibility of mail apps for intent
      resolution only; it adds no permission and no other capability.
    -->
    <intent>
      <action android:name="android.intent.action.SENDTO"/>
      <data android:scheme="mailto"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>

    <!--
      Android Repair 04 (notification icon/color native materialization).

      app.json's expo-notifications plugin config (icon:
      ./assets/notification-icon.png, color: #3F0B2F) is not itself native
      state -- Android is native-authoritative here
      (config/native-config-authority.json), and this is the exact
      meta-data shape expo-notifications@0.32.17's own config plugin
      generates (node_modules/expo-notifications/plugin/src/
      withNotificationsAndroid.ts: META_DATA_FCM_NOTIFICATION_ICON,
      META_DATA_LOCAL_NOTIFICATION_ICON, META_DATA_FCM_NOTIFICATION_ICON_COLOR,
      META_DATA_LOCAL_NOTIFICATION_ICON_COLOR), reproduced here directly
      rather than via `expo prebuild`. Both the FCM and Expo-Notifications
      keys are required: Firebase Messaging and expo-notifications' own
      local presentation code
      (ExpoNotificationBuilder.kt) each read their own key independently.
      Without these, ExpoNotificationBuilder.icon falls back to
      context.applicationInfo.icon -- the launcher icon -- for any
      notification, which is exactly the fallback this repair removes.
    -->
    <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="expo.modules.notifications.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/AppTheme" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="kscan"/>
      </intent-filter>
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="kscan.app" android:pathPrefix="/rooms"/>
      </intent-filter>
    </activity>
    <!-- Transitive from expo-camera's play-services-code-scanner dependency. K Scan
         never calls the GmsBarcodeScanning API (no onBarcodeScanned/barcodeScannerSettings
         usage anywhere in the app), so this delegate activity is unreachable; removed
         rather than left forcing portrait (GOOGLE-ANDROID-002). -->
    <activity android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity" tools:node="remove"/>

    <!--
      Android Repair 02 (merged-manifest foreground-service exposure). Three
      library-contributed foreground services K Scan never activates, each
      removed individually rather than as a package-wide exclusion so an
      unrelated future service from the same library is not silently dropped
      too. See the permission-block comment above for the fuller trace.

      expo-audio (node_modules/expo-audio/android/src/main/AndroidManifest.xml):
        AudioControlsService  -- foregroundServiceType="mediaPlayback"; only
          started by AudioPlayer.setActiveForLockScreen(), which
          stylistAudioPlayback.ts never calls.
        AudioRecordingService -- foregroundServiceType="microphone"; only
          started when an AudioRecorder is created (AudioRecorder.kt
          startService()); K Scan never imports/creates one -- the sole
          expo-audio call site only ever creates an AudioPlayer.

      expo-location (node_modules/expo-location/android/src/main/AndroidManifest.xml):
        LocationTaskService -- foregroundServiceType="location"; only started
          by the TaskManager-backed background-location task consumer
          (LocationTaskConsumer.startLocationUpdates()), reachable only
          through Location.startLocationUpdatesAsync()/startGeofencingAsync().
          K Scan's only expo-location call site
          (services/weather/weatherStylingContext.ts) calls solely the
          one-shot Location.getCurrentPositionAsync() for foreground weather
          styling; expo-task-manager is not even a project dependency.
    -->
    <service android:name="expo.modules.audio.service.AudioControlsService" tools:node="remove"/>
    <service android:name="expo.modules.audio.service.AudioRecordingService" tools:node="remove"/>
    <service android:name="expo.modules.location.services.LocationTaskService" tools:node="remove"/>
  </application>
</manifest>
