{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kscan.app/schemas/google-glasses-bridge/v1",
  "title": "KScanGoogleGlassesBridgeMessage",
  "type": "object",
  "required": ["type", "timestamp", "sessionId"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "HELLO",
        "DEVICE_STATE",
        "REQUEST_PERMISSIONS",
        "PERMISSIONS_RESULT",
        "CAPTURE_PHOTO",
        "PHOTO_CAPTURED",
        "PHOTO_ERROR",
        "ANALYSIS_STARTED",
        "ANALYSIS_RESULT",
        "SAVE_ITEM",
        "OPEN_ON_PHONE",
        "AUTH_SESSION",
        "ERROR"
      ]
    },
    "timestamp": { "type": "integer", "description": "Unix ms" },
    "sessionId": { "type": "string" },
    "requestId": { "type": "string" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "HELLO" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["client", "version"],
            "properties": {
              "client": { "type": "string", "enum": ["glasses", "phone"] },
              "version": { "type": "string" },
              "capabilities": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "DEVICE_STATE" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["connected", "capabilities"],
            "properties": {
              "connected": { "type": "boolean" },
              "batteryPercent": { "type": "number" },
              "capabilities": { "type": "object" },
              "bridgeMode": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "CAPTURE_PHOTO" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "preferSource": { "type": "string", "enum": ["glasses", "phone", "auto"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "PHOTO_CAPTURED" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["mimeType", "source"],
            "properties": {
              "mimeType": { "type": "string" },
              "source": { "type": "string", "enum": ["glasses", "phone", "mock"] },
              "imageRef": { "type": "string", "description": "Wi-Fi transfer ref or inline base64 in dev only" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "ANALYSIS_RESULT" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["result"],
            "properties": {
              "result": { "type": "object" },
              "topProducts": { "type": "array", "maxItems": 3 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "ERROR" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "recoverable": { "type": "boolean" }
            }
          }
        }
      }
    }
  ]
}
