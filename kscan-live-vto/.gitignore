# node_modules is already repo-root-ignored, but be explicit here too
# since this is a separate isolated npm workspace.
node_modules/

# Compiled TypeScript output — regenerated by `npm run build`, never
# hand-edited, and not meaningful to review as source.
dist/
*.tsbuildinfo

# Real device/simulator build output, once native/ios or native/android
# is ever actually built in a session with Xcode/Android Studio access.
native/ios/build/
native/ios/DerivedData/
native/android/**/build/
native/android/.gradle/

# Local, non-golden capture scratch (Section 13/16: never commit real
# camera/body imagery). Golden fixtures live under fixtures/ and are
# tracked deliberately, not via this ignore rule.
*.local.mp4
*.local.jpg
*.local.png
