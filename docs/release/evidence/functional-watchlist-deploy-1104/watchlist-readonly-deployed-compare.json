      "changes": [
        {
          "side": "canonical",
          "line": 19,
          "text": "function isTrackableTicketId(id: string): boolean {"
        },
        {
          "side": "canonical",
          "line": 20,
          "text": "  // Match watchlist_push_receipts_ticket_id_len and PostgreSQL text storage."
        },
        {
          "side": "canonical",
          "line": 21,
          "text": "  // Count Unicode characters, not UTF-16 units, without an unbounded array."
        },
        {
          "side": "canonical",
          "line": 22,
          "text": "  let characters = 0;"
        },
        {
          "side": "canonical",
          "line": 23,
          "text": "  for (const character of id) {"
        },
        {
          "side": "canonical",
          "line": 24,
          "text": "    if (character === '\\0' || ++characters > 200) return false;"
        },
        {
          "side": "canonical",
          "line": 25,
          "text": "  }"
        },
        {
          "side": "canonical",
          "line": 26,
          "text": "  return characters > 0;"
        },
        {
          "side": "canonical",
          "line": 27,
          "text": "}"
        },
        {
          "side": "canonical",
          "line": 28,
          "text": ""
        },
        {
          "side": "canonical",
          "line": 139,
          "text": "    // A single outbound push must produce exactly one accepted/rejected"
        },
        {
          "side": "canonical",
          "line": 140,
          "text": "    // ticket. HTTP 200 alone does not mean Expo accepted the message."
        },
        {
          "side": "canonical",
          "line": 141,
          "text": "    const tickets = Array.isArray(payload?.data) ? payload.data : null;"
        },
        {
          "side": "canonical",
          "line": 142,
          "text": "    if (!tickets || tickets.length !== 1) {"
        },
        {
          "side": "canonical",
          "line": 143,
          "text": "      return { attempted: true, ok: false, errorCode: 'ticket_error' };"
        },
        {
          "side": "canonical",
          "line": 144,
          "text": "    }"
        },
        {
          "side": "canonical",
          "line": 145,
          "text": "    const ticket = tickets[0];"
        },
        {
          "side": "deployed",
          "line": 129,
          "text": "    const ticket = Array.isArray(payload?.data) ? payload.data[0] : null;"
        },
        {
          "side": "canonical",
          "line": 150,
          "text": "    // NOTIF-12: even an accepted ticket is NOT proof of device delivery."
        },
        {
          "side": "canonical",
          "line": 151,
          "text": "    // Without a non-empty id the caller cannot persist a receipt or track"
        },
        {
          "side": "canonical",
          "line": 152,
          "text": "    // terminal delivery, so fail closed instead of fabricating acceptance."
        },
        {
          "side": "canonical",
          "line": 153,
          "text": "    const ticketId = ticket?.status === 'ok' && typeof ticket.id === 'string'"
        },
        {
          "side": "canonical",
          "line": 154,
          "text": "      ? ticket.id.trim()"
        },
        {
          "side": "canonical",
          "line": 155,
          "text": "      : '';"
        },
        {
          "side": "canonical",
          "line": 156,
          "text": "    if (!isTrackableTicketId(ticketId)) {"
        },
        {
          "side": "canonical",
          "line": 157,
          "text": "      return { attempted: true, ok: false, errorCode: 'ticket_error' };"
        },
        {
          "side": "canonical",
          "line": 158,
          "text": "    }"
        },
        {
          "side": "deployed",
          "line": 134,
          "text": "    // NOTIF-12: an accepted ticket is NOT proof of device delivery -- it only"
        },
        {
          "side": "deployed",
          "line": 135,
          "text": "    // means Expo queued it. The ticket id is what a receipt lookup is keyed"
        },
        {
          "side": "deployed",
          "line": 136,
          "text": "    // on, so it is retained rather than discarded; callers must treat"
        },
        {
          "side": "deployed",
          "line": 137,
          "text": "    // `ok: true` as \"accepted\", never as \"delivered\"."
        },
        {
          "side": "deployed",
          "line": 138,
          "text": "    const ticketId = typeof ticket?.id === 'string' ? ticket.id : undefined;"
        }
      ]
