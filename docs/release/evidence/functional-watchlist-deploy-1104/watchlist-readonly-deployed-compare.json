          "side": "canonical",
          "line": 469,
          "text": " *                   verified product page."
        },
        {
          "side": "canonical",
          "line": 470,
          "text": " *   invalid         not a usable destination (non-https, private, credentialed)"
        },
        {
          "side": "canonical",
          "line": 471,
          "text": " * Retailer-neutral: no retailer is named here."
        },
        {
          "side": "canonical",
          "line": 472,
          "text": " */"
        },
        {
          "side": "canonical",
          "line": 473,
          "text": "export type DestinationKind = 'direct' | 'search_handoff' | 'invalid';"
        },
        {
          "side": "canonical",
          "line": 474,
          "text": "export function classifyDestination(url: unknown): DestinationKind {"
        },
        {
          "side": "canonical",
          "line": 475,
          "text": "  const normalized = normalizeUrl(url);"
        },
        {
          "side": "canonical",
          "line": 476,
          "text": "  if (!normalized) return 'invalid';"
        },
        {
          "side": "canonical",
          "line": 477,
          "text": "  return isAggregatorDestination(normalized) ? 'search_handoff' : 'direct';"
        },
        {
          "side": "canonical",
