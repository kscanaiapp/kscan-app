        {
          "side": "canonical",
          "line": 466,
          "text": " *                   Shopping). It still lets the customer reach the offers, so it"
        },
        {
          "side": "canonical",
          "line": 467,
          "text": " *                   stays eligible, but it is ranked below direct retailer links,"
        },
        {
          "side": "canonical",
