        {
          "side": "canonical",
          "line": 462,
          "text": "/**"
        },
        {
          "side": "canonical",
          "line": 463,
          "text": " * How actionable a destination is, by URL alone."
        },
        {
          "side": "canonical",
          "line": 464,
          "text": " *   direct          a public https page on a host that is not a search middleman"
        },
        {
          "side": "canonical",
          "line": 465,
          "text": " *   search_handoff  a public https search/aggregator page (for example Google"
